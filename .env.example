# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=career_copilot
DATABASE_URL=postgresql+psycopg2://copilot:copilot@localhost:5432/career_copilot

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
