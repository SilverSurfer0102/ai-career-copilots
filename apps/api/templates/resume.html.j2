<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<title>{{ candidate_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Roboto', Arial, sans-serif;
    font-size: 10pt;
    color: #1a1a1a;
    background: #fff;
    padding: 1.8cm 1.8cm 2cm;
    max-width: 21cm;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 10px;
  }
  .header h1 {
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-bottom: 5px;
  }
  .contact-line {
    font-size: 9pt;
    color: #333;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 6px;
    align-items: center;
  }
  .contact-line a { color: #1a1a1a; text-decoration: none; }
  .sep { color: #888; padding: 0 2px; }

  section { margin-top: 10px; }
  section h2 {
    font-size: 11.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1.5px solid #1a1a1a;
    padding-bottom: 2px;
    margin-bottom: 6px;
  }

  .summary p {
    font-size: 9.5pt;
    line-height: 1.45;
  }

  .entry { margin-bottom: 7px; }
  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .entry-title  { font-weight: 700; font-size: 10pt; }
  .entry-date   { font-size: 9pt; color: #333; white-space: nowrap; }
  .entry-subrow { margin-top: 1px; margin-bottom: 2px; }
  .entry-subtitle { font-style: italic; font-size: 9pt; color: #444; }

  ul.bullets {
    margin-top: 3px;
    padding-left: 16px;
    list-style-type: disc;
  }
  ul.bullets li {
    font-size: 9.5pt;
    line-height: 1.4;
    margin-bottom: 2px;
  }

  .flat-list { font-size: 9.5pt; line-height: 1.6; }
  .flat-item { margin-bottom: 2px; }

  @media print {
    body { padding: 1.2cm; }
    a { color: #1a1a1a !important; text-decoration: none !important; }
  }
</style>
</head>
<body>

<div class="header">
  <h1>{{ candidate_name }}</h1>
  <div class="contact-line">
    {%- set ns = namespace(first=true) -%}
    {%- macro sep() %}{%- if not ns.first %}<span class="sep">|</span>{%- endif %}{%- set ns.first = false -%}{%- endmacro -%}
    {%- if phone %}{{ sep() }}<span>{{ phone }}</span>{% set ns.first = false %}{% endif -%}
    {%- if email %}{{ sep() }}<a href="mailto:{{ email }}">{{ email }}</a>{% set ns.first = false %}{% endif -%}
    {%- if linkedin %}{{ sep() }}<a href="{{ linkedin }}">{{ linkedin | replace('https://','') | replace('http://','') }}</a>{% set ns.first = false %}{% endif -%}
    {%- if github %}{{ sep() }}<a href="{{ github }}">{{ github | replace('https://','') | replace('http://','') }}</a>{% set ns.first = false %}{% endif -%}
    {%- if website and website != linkedin and website != github %}{{ sep() }}<a href="{{ website }}">{{ website | replace('https://','') | replace('http://','') }}</a>{% endif -%}
  </div>
</div>

{% if professional_summary %}
<section class="summary">
  <h2>{% if lang == 'de' %}Zusammenfassung{% elif lang == 'fr' %}Résumé professionnel{% else %}Summary{% endif %}</h2>
  <p>{{ professional_summary }}</p>
</section>
{% endif %}

{% for section in sections %}
<section>
  <h2>{{ section.title }}</h2>
  {% set items = section['items'] if 'items' in section else [] %}
  {% for item in items %}
  <div class="entry">
    <div class="entry-header">
      <span class="entry-title">{{ item.title or '' }}</span>
      <span class="entry-date">{{ item.date_range or '' }}</span>
    </div>
    {% if item.subtitle or item.location %}
    <div class="entry-subrow">
      <span class="entry-subtitle">
        {{- item.subtitle or '' -}}
        {%- if item.subtitle and item.location %} · {% endif -%}
        {{- item.location or '' -}}
      </span>
    </div>
    {% endif %}
    {% if item.bullets %}
    <ul class="bullets">
      {% for b in item.bullets %}
      {% set txt = b.text if b is mapping else b %}
      {% if txt %}<li>{{ txt }}</li>{% endif %}
      {% endfor %}
    </ul>
    {% endif %}
    {% if not item.bullets and item.description %}
    <p style="font-size:9.5pt;margin-top:2px;">{{ item.description }}</p>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}

</body>
</html>
