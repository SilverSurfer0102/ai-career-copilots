<!DOCTYPE html>
<html lang="{{ lang | default('de') }}">
<head>
<meta charset="UTF-8">
<title>{% if lang == 'de' %}Anschreiben{% else %}Cover Letter{% endif %} — {{ candidate_name }}</title>
<style>
  :root { --accent: #1d4c8f; --text: #1a1a1a; --muted: #5b5f66; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, "Segoe UI", sans-serif;
    font-size: 10.5pt;
    line-height: 1.55;
    color: var(--text);
    max-width: 21cm;
    margin: 0 auto;
    padding: 1.6cm 1.9cm 1.8cm;
    background: #fff;
  }
  .sender {
    font-size: 9pt;
    color: var(--muted);
    border-bottom: 1px solid #d8dee8;
    padding-bottom: 8px;
    margin-bottom: 24px;
  }
  .sender .name { font-weight: 700; color: var(--text); font-size: 10.5pt; }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 26px;
  }
  .recipient { font-size: 10pt; }
  .date { font-size: 10pt; color: var(--muted); white-space: nowrap; }
  .subject {
    font-weight: 700;
    font-size: 11pt;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .body p { margin-bottom: 12px; font-size: 10.5pt; text-align: left; }
  .closing { margin-top: 22px; }
  .closing .signature { margin-top: 22px; font-weight: 700; }
</style>
</head>
<body>

<div class="sender">
  <div class="name">{{ candidate_name }}</div>
  {% if contact %}<div>{{ contact }}</div>{% endif %}
</div>

<div class="meta-row">
  <div class="recipient">
    {% if recipient_name %}{{ recipient_name }}<br>{% endif %}
    {% if company_name %}{{ company_name }}{% endif %}
  </div>
  <div class="date">{{ date }}</div>
</div>

<div class="subject">
  {% if lang == 'de' %}Bewerbung als {{ position_title }}{% else %}Application for {{ position_title }}{% endif %}
</div>

<div class="body">
  {% if opening_salutation %}<p>{{ opening_salutation }}</p>{% endif %}
  {% for para in paragraphs %}
  <p>{{ para.text }}</p>
  {% endfor %}
</div>

<div class="closing">
  <p>{{ closing_salutation }},</p>
  <p class="signature">{{ candidate_name }}</p>
</div>

</body>
</html>
